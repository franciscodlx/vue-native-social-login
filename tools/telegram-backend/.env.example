# Copy to .env (never commit it) and run: node --env-file=.env server.mjs

# "telegram" for the real service, "mock" for examples/mock-idp (default).
PROVIDER=telegram

# From @BotFather → your bot → Login Widget
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Public https URL of this server, e.g. a Cloudflare Tunnel or ngrok URL.
# Add <PUBLIC_URL>/auth/telegram/callback to the Allowed URLs in BotFather.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=telegramexample://callback

PORT=4500
