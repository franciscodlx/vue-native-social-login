# Copy to .env (never commit it) and run: node --env-file=.env server.mjs

# "twitch" for the real service, "mock" for examples/mock-idp (default).
PROVIDER=twitch

# From https://dev.twitch.tv/console/apps → Manage
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public https URL of this server, e.g. a Cloudflare Tunnel or ngrok URL.
# Register <PUBLIC_URL>/auth/twitch/callback as an OAuth Redirect URL of the
# Twitch application.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=twitchexample://callback

PORT=4300
