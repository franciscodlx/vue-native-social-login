# Copy to .env (never commit it) and run: node --env-file=.env server.mjs

# "mercadolibre" for the real service, "mock" for examples/mock-idp (default).
PROVIDER=mercadolibre

# From https://developers.mercadolibre.com → Mis aplicaciones
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# Public https URL of this server (a Cloudflare Tunnel or ngrok URL). Register
# <PUBLIC_URL>/auth/mercadolibre/callback as the redirect URI of the application.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=meliexample://callback

PORT=4200
