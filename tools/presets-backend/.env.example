# Copy to .env (never commit it) and run: node --env-file=.env server.mjs
#
# A provider with both values set talks to the real service; the others keep
# using examples/mock-idp, so you can try one provider at a time.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public https URL of this server (a Cloudflare Tunnel or ngrok URL). Register
# <PUBLIC_URL>/auth/<provider>/callback in each provider. Required as soon as
# one provider is real.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=presetsexample://callback

PORT=4400
