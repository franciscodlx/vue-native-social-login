# Copy to .env (never commit it) and run: node --env-file=.env server.mjs

# "tiktok" for the real service, "mock" for examples/mock-idp (default).
PROVIDER=tiktok

# From https://developers.tiktok.com → Manage apps → Credentials (Client key, Client secret)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Public https URL of this server (a Cloudflare Tunnel or ngrok URL). Register
# <PUBLIC_URL>/auth/tiktok/callback as the redirect URI of the application.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=tiktokexample://callback

PORT=4600
