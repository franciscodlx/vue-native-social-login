# Copy to .env (never commit it) and run: node --env-file=.env server.mjs

# "linkedin" for the real service, "mock" for examples/mock-idp (default).
PROVIDER=linkedin

# From https://www.linkedin.com/developers/apps → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public https URL of this server (LinkedIn only accepts https redirects),
# e.g. a Cloudflare Tunnel or ngrok URL. Register
# <PUBLIC_URL>/auth/linkedin/callback as the redirect URL in the LinkedIn app.
PUBLIC_URL=https://example.trycloudflare.com

# Where the app listens. Must match the scheme registered in the app.
APP_CALLBACK=linkedinexample://callback

PORT=4100
