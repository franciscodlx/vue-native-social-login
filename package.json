{
  "name": "vue-native-social-login",
  "version": "0.0.0",
  "private": true,
  "description": "Social login plugins for Vue Native (vue-native.dev): OAuth 2.0 + PKCE in the system browser, one package per provider on a shared core",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "lint": "eslint packages examples/demo/app",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
